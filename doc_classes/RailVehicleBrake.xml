<?xml version="1.0" encoding="UTF-8" ?>
<class name="RailVehicleBrake" inherits="RailVehicleComponent" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Represents and configures the vehicle brake system and exposes controls to operate it.
	</brief_description>
	<description>
		RailVehicleBrake provides access to the underlying MaSzyna brake model for a vehicle. It lets you:
		- Configure key pneumatic parameters (pressures, tank volumes, cylinder geometry, friction method).
		- Select the brake distributor/valve type used by the vehicle.
		- Operate the main brake handle and auxiliary features like the brake releaser.
	</description>
