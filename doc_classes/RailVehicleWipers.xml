			<description>
			</description>
		</method>
	</methods>
	<members>
		<member name="angle" type="float" setter="set_angle" getter="get_angle" default="0.0">
			[code]WiperList:Angle[/code]
			The wiper's working angle.
		</member>
		<member name="default_position" type="int" setter="set_default_position" getter="get_default_position" default="0">
			[code]WiperList:Default[/code]
