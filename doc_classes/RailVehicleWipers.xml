<?xml version="1.0" encoding="UTF-8" ?>
<class name="RailVehicleWipers" inherits="RailVehicleComponent" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Configures the windshield wiper programmer switch.
	</brief_description>
	<description>
		[RailVehicleWipers] wraps the FIZ [code]WiperList:[/code] section.
		[b]Not part of the simulation:[/b] the vehicle's simulation has no wiper state or configuration, so the
		wipers - the switch and the movement of every wiper - are simulated by this component itself.
	</description>
