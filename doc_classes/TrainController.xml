<?xml version="1.0" encoding="UTF-8" ?>
<class name="TrainController" inherits="Node" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Base train controller controlling all train systems
	</brief_description>
	<description>
		Base train controller node.
		It allows building behaviour of the train by adding child nodes of the [TrainPart] class.
		When node is added to the scene tree,
		the train is automatically registered in the [TrainSystem] with an unique identifier [member TrainController.train_id].
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="battery" qualifiers="const">
			<return type="void" />
			<param index="0" name="enabled" type="bool" />
			<description>
				Turn on/off train battery
			</description>
		</method>
		<method name="broadcast_command">
			<return type="void" />
			<param index="0" name="command" type="String" />
			<param index="1" name="p1" type="Variant" default="null" />
			<param index="2" name="p2" type="Variant" default="null" />
			<description>
				Broadcasts command to all trains (including self)
			</description>
		</method>
		<method name="direction_decrease" qualifiers="const">
			<return type="void" />
			<description>
				Increase direction by one step
			</description>
		</method>
		<method name="direction_increase" qualifiers="const">
			<return type="void" />
			<description>
				Decrease direction by one step
			</description>
		</method>
		<method name="main_controller_decrease" qualifiers="const">
			<return type="void" />
			<param index="0" name="step" type="int" default="1" />
			<description>
				Decrease main controller position
			</description>
		</method>
		<method name="main_controller_increase" qualifiers="const">
			<return type="void" />
			<param index="0" name="step" type="int" default="1" />
			<description>
				Increase main controller position
			</description>
		</method>
		<method name="radio">
			<return type="void" />
			<param index="0" name="enabled" type="bool" />
			<description>
				Turn on/off the radio
			</description>
		</method>
		<method name="radio_channel_decrease">
			<return type="void" />
			<param index="0" name="step" type="int" default="1" />
			<description>
				Decrease radio channel
			</description>
		</method>
		<method name="radio_channel_increase">
			<return type="void" />
			<param index="0" name="step" type="int" default="1" />
			<description>
				Increase radio channel
			</description>
		</method>
		<method name="register_command">
			<return type="void" />
			<param index="0" name="command" type="String" />
			<param index="1" name="callable" type="Callable" />
			<description>
				Registers command for train controlled by this node.
				This is a shortcut for [method TrainSystem.register_command].
			</description>
		</method>
		<method name="send_command" qualifiers="const">
			<return type="void" />
			<param index="0" name="command" type="StringName" />
			<param index="1" name="p1" type="Variant" default="null" />
			<param index="2" name="p2" type="Variant" default="null" />
			<description>
				Sends command to train controlled by this node.
				This is a shortcut for [method TrainSystem.send_command].
			</description>
		</method>
		<method name="unregister_command">
			<return type="void" />
			<param index="0" name="command" type="String" />
			<param index="1" name="callable" type="Callable" />
			<description>
				Removes command of a train controlled by this node from the registry.
				This is a shortcut for [method TrainSystem.unregister_command].
			</description>
		</method>
		<method name="update_config">
			<return type="void" />
			<param index="0" name="_unnamed_arg0" type="Dictionary" />
			<description>
			</description>
		</method>
		<method name="update_mover" experimental="true">
			<return type="void" />
			<description>
				Updates iternal mover based on the config stored in node properties (should not be called directly)
			</description>
		</method>
		<method name="update_state" experimental="true">
			<return type="void" />
			<description>
				Forces update of the state (should not be called directly)
			</description>
		</method>
	</methods>
	<members>
		<member name="battery_voltage" type="float" setter="set_battery_voltage" getter="get_battery_voltage" default="0.0">
			[code]Light:LMaxVoltage[/code]
		</member>
		<member name="cntrl/automatic_cab_activation" type="bool" setter="set_automatic_cab_activation" getter="get_automatic_cab_activation" default="true">
			[code]Cntrl.AutomaticCabActivation[/code]
		</member>
		<member name="cntrl/battery_start_mode" type="int" setter="set_battery_start_mode" getter="get_battery_start_mode" enum="TrainController.StartMode" default="1">
			[code]Cntrl.BatteryStart[/code]
		</member>
		<member name="cntrl/compartment_lights_start_mode" type="int" setter="set_compartment_lights_start_mode" getter="get_compartment_lights_start_mode" enum="TrainController.StartMode" default="0">
			[code]Cntrl.CompartmentLightsStart[/code]
		</member>
		<member name="cntrl/ground_relay_start_mode" type="int" setter="set_ground_relay_start_mode" getter="get_ground_relay_start_mode" enum="TrainController.StartMode" default="1">
			[code]Cntrl.GroundRelayStart[/code]
		</member>
		<member name="cntrl/inactive_cab_flag" type="int" setter="set_inactive_cab_flag" getter="get_inactive_cab_flag" default="0">
			[code]Cntrl.InactiveCabFlag[/code]
			Bitmask of automatic actions performed on cab deactivation/activation.
		</member>
		<member name="category" type="int" setter="set_category" getter="get_category" enum="TrainController.Category" default="1">
			[code]Param.Category[/code]
			The vehicle's category (train, road, ship, airplane).
		</member>
		<member name="config" type="Dictionary" setter="" getter="get_config" default="{}">
			Returns a dictionary with all config properties of the train.
			This is a shortcut for iterating over [method TrainSystem.get_supported_config_properties] to read each from [method TrainSystem.get_config_property].
		</member>
		<member name="dimensions/drag_coefficient" type="float" setter="set_drag_coefficient" getter="get_drag_coefficient" default="0.0">
			[code]Dimensions:Cx[/code]
			Aerodynamic drag coefficient.
		</member>
		<member name="dimensions/floor_height" type="float" setter="set_floor_height" getter="get_floor_height" default="0.96">
			[code]Dimensions:Floor[/code]
			Floor height above the rail head, in meters; used to position universal cargo loads.
		</member>
		<member name="dimensions/height" type="float" setter="set_height" getter="get_height" default="0.0">
			[code]Dimensions:H[/code]
			Vehicle height, in meters.
		</member>
		<member name="dimensions/length" type="float" setter="set_length" getter="get_length" default="0.0">
			[code]Dimensions:L[/code]
			Vehicle length, in meters.
		</member>
		<member name="dimensions/width" type="float" setter="set_width" getter="get_width" default="0.0">
			[code]Dimensions:W[/code]
			Vehicle width, in meters.
		</member>
		<member name="heating_power" type="float" setter="set_heating_power" getter="get_heating_power" default="0.0">
			[code]Param.HeatingP[/code]
			Power drawn for heating, in kW.
		</member>
		<member name="light_power" type="float" setter="set_light_power" getter="get_light_power" default="0.0">
			[code]Param.LightP[/code]
			Power drawn for lighting, in kW.
		</member>
		<member name="mass" type="float" setter="set_mass" getter="get_mass" default="0.0">
			[code]Param.M[/code] Mass of the train
		</member>
		<member name="max_velocity" type="float" setter="set_max_velocity" getter="get_max_velocity" default="0.0">
			[code]Param.Vmax[/code]
		</member>
		<member name="power" type="float" setter="set_power" getter="get_power" default="0.0">
			[code]Param.PWR[/code]
		</member>
		<member name="radio_channel_max" type="int" setter="set_radio_channel_max" getter="get_radio_channel_max" default="0">
			Maximum radio channel number
		</member>
		<member name="radio_channel_min" type="int" setter="set_radio_channel_min" getter="get_radio_channel_min" default="0">
			Minimum radio channel number
		</member>
		<member name="reduced_mass" type="float" setter="set_reduced_mass" getter="get_reduced_mass" default="0.0">
			[code]Param.Mred[/code]
			Reduced (rotating) mass, added to [member mass] for braking calculations.
		</member>
		<member name="sand_capacity" type="float" setter="set_sand_capacity" getter="get_sand_capacity" default="0.0">
			[code]Param.SandCap[/code]
			Sand box capacity, in kg.
		</member>
		<member name="state" type="Dictionary" setter="" getter="get_state" default="{}">
			Actual state of the train
		</member>
		<member name="train_id" type="String" setter="set_train_id" getter="get_train_id" default="&quot;&quot;">
			Unique identifier of the train. See [method TrainSystem.register_train].
		</member>
		<member name="train_type" type="int" setter="set_train_type" getter="get_train_type" enum="TrainController.TrainType" default="0">
			[code]Param.Type[/code]
			Bitmask identifying a vehicle's special-cased behavior family (e.g. EZT, ET22, ET40, ET42, EP05, DMU).
			Not every value listed on the FIZ wiki is implemented by the mover - only the ones with a matching
			[code]dt_*[/code] constant in [code]MOVER.h[/code] are exposed here (notably, [code]182[/code] is missing).
		</member>
		<member name="type_name" type="String" setter="set_type_name" getter="get_type_name" default="&quot;&quot;">
			Train type name
		</member>
	</members>
	<signals>
		<signal name="command_received">
			<param index="0" name="command" type="String" />
			<param index="1" name="p1" type="Variant" />
			<param index="2" name="p2" type="Variant" />
			<description>
				Emitted when train receives a command
			</description>
		</signal>
		<signal name="config_changed">
			<description>
				Train configuration changed
			</description>
		</signal>
		<signal name="mover_config_changed">
			<description>
				Train internal configuration changed
			</description>
		</signal>
		<signal name="mover_initialized">
			<description>
				Train internal subsystem initialized
			</description>
		</signal>
		<signal name="power_changed">
			<param index="0" name="is_powered" type="bool" />
			<description>
				Train power state changed
			</description>
		</signal>
		<signal name="radio_channel_changed">
			<param index="0" name="channel" type="int" />
			<description>
				Emitted when selected radio channel changes
			</description>
		</signal>
		<signal name="radio_toggled">
			<param index="0" name="is_enabled" type="bool" />
			<description>
				Train radio switched on or off
			</description>
		</signal>
	</signals>
	<constants>
		<constant name="START_MODE_DISABLED" value="0" enum="StartMode">Device is disabled / not present.</constant>
		<constant name="START_MODE_MANUAL" value="1" enum="StartMode">Device is started manually, with a switch.</constant>
		<constant name="START_MODE_AUTOMATIC" value="2" enum="StartMode">Device starts automatically.</constant>
		<constant name="START_MODE_MANUAL_WITH_AUTO_FALLBACK" value="3" enum="StartMode">Device is started manually, or automatically as a fallback.</constant>
		<constant name="START_MODE_CONVERTER" value="4" enum="StartMode">Device starts together with the converter.</constant>
		<constant name="START_MODE_BATTERY" value="5" enum="StartMode">Device starts together with the battery.</constant>
		<constant name="START_MODE_DIRECTION" value="6" enum="StartMode">Device starts once a direction is selected.</constant>
		<constant name="POWER_SOURCE_NOT_DEFINED" value="0" enum="TrainPowerSource">
			Indicates that the power source is not defined.
		</constant>
		<constant name="POWER_SOURCE_INTERNAL" value="1" enum="TrainPowerSource">
			Represents an internal power source (e.g., battery).
		</constant>
		<constant name="POWER_SOURCE_TRANSDUCER" value="2" enum="TrainPowerSource">
			Represents a power source via transducer.
		</constant>
		<constant name="POWER_SOURCE_GENERATOR" value="3" enum="TrainPowerSource">
			Represents a power source via generator.
		</constant>
		<constant name="POWER_SOURCE_ACCUMULATOR" value="4" enum="TrainPowerSource">
			Represents a power source via accumulator.
		</constant>
		<constant name="POWER_SOURCE_CURRENTCOLLECTOR" value="5" enum="TrainPowerSource">
			Represents a power source via current collector.
		</constant>
		<constant name="POWER_SOURCE_POWERCABLE" value="6" enum="TrainPowerSource">
			Represents a power source via power cable.
		</constant>
		<constant name="POWER_SOURCE_HEATER" value="7" enum="TrainPowerSource">
			Represents a power source via heater.
		</constant>
		<constant name="POWER_SOURCE_MAIN" value="8" enum="TrainPowerSource">
			Represents the main power source.
		</constant>
		<constant name="POWER_TYPE_NONE" value="0" enum="TrainPowerType">
			Indicates no power type.
		</constant>
		<constant name="POWER_TYPE_BIO" value="1" enum="TrainPowerType">
			Represents bio fuel power.
		</constant>
		<constant name="POWER_TYPE_MECH" value="2" enum="TrainPowerType">
			Represents mechanical power.
		</constant>
		<constant name="POWER_TYPE_ELECTRIC" value="3" enum="TrainPowerType">
			Represents electric power.
		</constant>
		<constant name="POWER_TYPE_STEAM" value="4" enum="TrainPowerType">
			Represents steam power.
		</constant>
	</constants>
</class>
