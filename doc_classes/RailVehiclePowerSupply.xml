<?xml version="1.0" encoding="UTF-8" ?>
<class name="RailVehiclePowerSupply" inherits="RailVehicleComponent" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		The vehicle's low voltage: the battery, the converter and the 24 V / 110 V supply they feed.
	</brief_description>
	<description>
		A carriage has one as well as a locomotive - a FIZ describes it by [code]Light:LMaxVoltage[/code] or by the battery and converter keys of [code]Cntrl.[/code]. A vehicle without one (a freight wagon) has no low voltage.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="battery">
			<return type="void" />
			<param index="0" name="enabled" type="bool" />
			<description>
				Turn on/off train battery
			</description>
		</method>
		<method name="converter">
			<return type="void" />
			<param index="0" name="enabled" type="bool" />
			<description>
				Switches the converter ([code]ConverterSwitch()[/code]); the command is sent along the control line to the vehicles that carry one.
			</description>
		</method>
		<method name="get_battery_enabled" qualifiers="const">
			<return type="bool" />
			<description>
			</description>
		</method>
		<method name="get_converter_allowed" qualifiers="const">
			<return type="bool" />
			<description>
			</description>
		</method>
		<method name="get_converter_enabled" qualifiers="const">
			<return type="bool" />
			<description>
			</description>
		</method>
		<method name="get_converter_time_to_start" qualifiers="const">
			<return type="float" />
			<description>
			</description>
		</method>
		<method name="get_live_battery_voltage" qualifiers="const">
			<return type="float" />
			<description>
			</description>
		</method>
		<method name="get_power24_available" qualifiers="const">
			<return type="bool" />
			<description>
			</description>
		</method>
		<method name="get_power24_voltage" qualifiers="const">
			<return type="float" />
			<description>
			</description>
		</method>
		<method name="get_power110_available" qualifiers="const">
			<return type="bool" />
			<description>
			</description>
		</method>
	</methods>
	<members>
		<member name="battery_voltage" type="float" setter="set_battery_voltage" getter="get_battery_voltage" default="0.0">
			[code]Light:LMaxVoltage[/code] - the nominal battery voltage
		</member>
		<member name="cntrl_battery_start_mode" type="int" setter="set_cntrl_battery_start_mode" getter="get_cntrl_battery_start_mode" enum="RailVehicleController.StartMode" default="1">
			[code]Cntrl.BatteryStart[/code]
		</member>
		<member name="cntrl_converter_start_delay" type="float" setter="set_cntrl_converter_start_delay" getter="get_cntrl_converter_start_delay" default="0.0">
			[code]Cntrl.ConverterStartDelay[/code]
		</member>
		<member name="cntrl_converter_start_mode" type="int" setter="set_cntrl_converter_start_mode" getter="get_cntrl_converter_start_mode" enum="RailVehicleController.StartMode" default="1">
			[code]Cntrl.ConverterStart[/code]
		</member>
	</members>
	<signals>
		<signal name="power_changed">
			<param index="0" name="is_powered" type="bool" />
			<description>
				The low voltage came or went
			</description>
		</signal>
	</signals>
</class>
