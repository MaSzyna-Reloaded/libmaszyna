; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="libmaszyna demo"
config/description="The demo of libmaszyna (MaSzyna Reloaded Core): the Mover, a 3D scene and the debug HUD"
config/version="2026-09-19"
run/main_scene="res://demo_3d.tscn"
run/print_header=false
config/use_custom_user_dir=true
config/custom_user_dir_name="MaSzyna-Reloaded"
config/features=PackedStringArray("4.7", "Double Precision", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="res://splash.png"
config/icon="res://icon.svg"
run/print_header.release=true

[audio]

buses/default_bus_layout="uid://cnafyk2xbhsdb"
general/3d_panning_strength=0.55

[autoload]

TrackRenderingServer="*res://addons/libmaszyna/tracks/track_rendering_server.gd"
TractionRenderingServer="*res://addons/libmaszyna/traction/traction_rendering_server.gd"
MaszynaSceneryChunkRenderingServer="*res://addons/libmaszyna/legacy/scenery/maszyna_scenery_chunk_rendering_server.gd"
SmokeSourceLibrary="*res://addons/libmaszyna/smoke/smoke_source_library.gd"
NodebankLibraryBuilder="*uid://dv25nc25tcanw"
Console="*uid://d046w0soh2iou"
MaterialManager="*uid://wsbd7kr83ncg"
MaszynaMaterialParser="*uid://7b48fl428yqa"
MaszynaMaterialFactory="*uid://v144f3irjg7m"
E3DModelManager="*uid://b2v733o52i40x"
MaszynaLegacyVehicleSystem="*res://addons/libmaszyna/legacy/vehicle/maszyna_legacy_vehicle_system.gd"
MaszynaVehicleProfileManager="*res://addons/libmaszyna/legacy/vehicle/maszyna_vehicle_profile_manager.gd"
E3DModelTool="*uid://df7a5f7f35wd1"
AudioStreamManager="*uid://cp8sgfk334adm"
TranscriptSystem="*res://addons/libmaszyna/sound/transcript_system.gd"
TrainSoundSystem="*res://addons/libmaszyna/sound/train_sound_system.gd"
CabinSystem="*res://addons/libmaszyna/cabin/cabin_system.gd"
GndSfxServer="*res://addons/gnd_sfx/gnd_sfx_server.gd"
ScenerySoundServer="*res://addons/libmaszyna/sound/scenery_sound_server.gd"
FIZResourceLoaderRegistrar="*uid://c3g4562u11dp2"
DebugMenu="*uid://cggqb75a8w8r"
SceneryInstancer="*uid://d33kyubri6utw"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/app.log"

[display]

window/size/mode=3

[editor_overrides]

text_editor/behavior/files/trim_trailing_whitespace_on_save=true

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/gnd_sfx/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/libmaszyna/editor/scenery_streaming/plugin.cfg", "res://addons/libmaszyna/editor/maszyna_vehicles/plugin.cfg", "res://addons/libmaszyna/editor/e3d_toolbar/plugin.cfg", "res://addons/libmaszyna/editor/fiz_toolbar/plugin.cfg", "res://addons/libmaszyna/editor/nodebank/plugin.cfg", "res://addons/libmaszyna/editor/scenery_toolbar/plugin.cfg", "res://addons/libmaszyna/editor/tracks/plugin.cfg", "res://addons/libmaszyna/editor/user_settings_dock/plugin.cfg", "res://addons/libmaszyna/plugin.cfg")

