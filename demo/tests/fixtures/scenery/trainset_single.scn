// a trainset of one vehicle, not coupled to a next one - what the player adds to it in the
// scenery selector has no declared coupling to take (MaSzyna-Reloaded/libmaszyna#305)
node -1 0 main_track track normal 300.0 1.435 0.15 25.0 20 0 flat vis
 rail_screw_used1 6 1435mm/tpbps-new2 0.2 0.5 1.1
0.0 0.2 0.0  0.0  //point 1
0.0 0.0 0.0  //control vector 1
0.0 0.0 0.0  //control vector 2
0.0 0.2 300.0  0.0  //point 2
0
endtrack
trainset single main_track 150 0
node -1 0 loco dynamic test/synthetic_v1 none synthetic 0 headdriver 0 0 enddynamic
endtrainset
