// to jest plik z parametrami dla EU04
// stale uniwersalne stosowane dla kazdego pojazdu
Author chk: EU07-457,Bartosz "ET22_RULZ" Wojciechowski
# prametry hamulca dla SPKS: youBy
Param. Category=train M=87200 Mred=12000 Vmax=110 PWR=1680 SandCap=500 type=EU04
// rodzaj (train,auto,ship), masa [kg], Vmax [km/h], moc [kW] 
Dimensions: L=16.238 H=4.343 W=2.903 Cx=0.3 
// dlugosc ze zderzakami, wysokosc, szerokosc [m], wspolcz. oporu aerodynam.
Wheels: D=1.350 AIM=2000 Tw=1.435 Axle=Bo'Bo' Ad=3.05 Bd=8.55 Rmin=140 BearingType=Roll
// srednica kol napednych, moment bezwladosci [kgm^2], szerokosc, uklad i rozstaw osi, rozstaw czopow, min. promien skretu [m]
Brake: BrakeValve=K NBpA=4 MBF=85.0 MaxBP=2.8 RM=0.43 LocMaxBP=3.5 BCN=8 BCR=0.1524 BCD=0.12 BCM=8.7 HiPP=5 LoPP=3.5 Vv=0.83 MinCP=7.0 MaxCP=8.0 CompressorSpeed=0.03 BCS=0.8 BSA=0 BM=P10-Bgu BVV=200 BRE=0.8
// ilosc elementow ciernych na os, max sila docisku ham. recznego [kN], max. cisnienie w cyl., 
// cylindry: ilosc, promien, skok roboczy, mnoznik przekladni,
// cisnienie nominalne w przew. glownym [MPa], opcjonalnie dane dotyczace sprezarki i zbiornika glownego
BuffCoupl. CType=Screw kB=9200 DmaxB=0.15 FmaxB=740 kC=4800 DmaxC=0.15 FmaxC=780 beta=0.58 AllowedFlag=103
// urzadzenia zderzno-cieglowe, sily w kN (uwaga - sprezystosc kB to 2*sprezystosc pojedynczego zderzaka!)
Cntrl. BrakeDelays=GPRR BrakeHandle=Knorr LocBrakeHandle=Knorr BrakeSystem=Pneumatic BCPN=4 BDelay1=15 BDelay2=4 BDelay3=35 BDelay4=25 ManualBrake=Yes ASB=Manual LocalBrake=PneumaticBrake DynamicBrake=Passive BrakeDelays=GPR MCPN=31 SCPN=8 AutoRelay=Optional IniCDelay=0.4 SCDelay=0.4
-1	0.90	0	15	Pneumatic
 0	0.50	0	9	Pneumatic
 1	-1	-1	0	Pneumatic
 2	-1	-1	5	Pneumatic
 3	0.001	-1	9	Pneumatic
 4	0.00	-1	15	Pneumatic
// tabelka z parametrami nastaw glownego hamulca: cisnienie w przewodzie glowny, cylindrach (-1: nie dotyczy), szybkosc nap.,
// powyzej rodzaj hamulca zespolonego, ilosc nastaw hamulca oraz opoznienie dzialania, typ hamulca niesamoczynnego
// ilosc nastaw glownego i dodatkowego nastawnika, rozruch aut., opoznienia zadzialania stycznikow
//Security: AwareSystem=Active,CabSignal AwareDelay=60 SoundSignalDelay=5 MaxHoldTime=1.0 EmergencyBrakeDelay=6 RadioStop=Yes 
// systemy zabezpieczajace: czuwaki, sygnalizacja kabinowa itp
Light: Light=Generator LGeneratorEngine=ElectricSeriesMotor LMaxVoltage=110 LMaxCurrent=155  
// zrodlo mocy dla oswietlenia
Clima: Heating=Main
Power: EnginePower=CurrentCollector CollectorsNo=2 MaxVoltage=3600 MaxCurrent=1000 MinH=0.38 MaxH=2.4 CSW=1.4 PhysicalLayout=3
// zrodlo mocy dla silnikow trakcyjnych
Engine: EngineType=ElectricSeriesMotor Volt=1500 Trans=21:81 WindingRes=0.1411 nmax=2075
