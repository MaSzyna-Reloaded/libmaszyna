// to jest plik z parametrami dla EN96
// stale uniwersalne stosowane dla kazdego pojazdu
# prametry hamulca dla SPKS: youBy
Param. Category=train M=41000 Vmax=160 PWR=800 SandCap=500 Type=ezt HeatingP=37
Load: MaxLoad=95 LoadQ=pieces LoadAccepted=Passengers,Pantstate OverLoadFactor=2.3 LoadSpeed=1 UnLoadSpeed=2
// rodzaj (train,auto,ship), masa [kg], Vmax [km/h], moc [kW] 
Dimensions: L=21.081 H=4.228 W=2.96 Cx=0.1
// dlugosc ze zderzakami, wysokosc, szerokosc [m], wspolcz. oporu aerodynam.
Wheels: D=0.850 AIM=400 Tw=1.435 Axle=1'Bo' Ad=2.83 Bd=16.3 Rmin=80 BearingType=Roll
// srednica kol napednych, moment bezwladosci [kgm^2], szerokosc, uklad i rozstaw osi, rozstaw czopow, min. promien skretu [m]
Brake: BrakeValve=EStED NBpA=2 MBF=85.0 MaxBP=3.1 MaxLBP=4.2 RM=0.74 RV=-1 BCN=6 BCR=0.127 BCD=0.05 BCM=1.9075 HiPP=5 LoPP=3.5 Vv=0.1 MinCP=7.7 MaxCP=9.0 CompressorSpeed=0.025 BVV=176 BM=Cosid BCS=1 BSA=0.00 BRE=0.95 TareMaxBP=2.37 CompressorPower=Converter LPOn=3.0 LPOff=4.5 UBB1=2 UBB2=8 
SpringBrake: Volume=20 MBF=5.8 MaxSP=5.5 ResetP=4.0 MinFP=3.5 PressOff=4.5 PressOn=4.2 ValveOnArea=0.0005 ValveOffArea=0.0005 ValvePNBArea=0.002 MTC=4
Doors: OpenCtrl=Mixed CloseCtrl=DriverCtrl OpenSpeed=0.24 CloseSpeed=0.2 DoorMaxShiftL=0.74 DoorMaxShiftR=0.74 DoorOpenMethod=Plug DoorStayOpen=5.0 DoorClosureWarningAuto=Yes DoorBlocked=Yes DoorMaxShiftPlug=0.05 DoorCloseDelay=1.8 PlatformMaxShift=0.270 PlatformSpeed=0.4 PlatformOpenMethod=Shift MirrorMaxShift=45 DoorNeedPermit=Yes DoorPermitList=1|0|2|3 DoorPermitListDefault=2 DoorAutoCloseRemote=Yes MirrorVelClose=25
BuffCoupl1. CType=Articulated kB=4200 DmaxB=0.05 FmaxB=1740 kC=6800 DmaxC=0.15 FmaxC=780 beta=0.58 AllowedFlag=-255
BuffCoupl2. CType=Automatic kB=4200 DmaxB=0.05 FmaxB=1740 kC=6800 DmaxC=0.15 FmaxC=780 beta=0.58 AllowedFlag=39 AutomaticFlag=39 ControlType=en96
// urzadzenia zderzno-cieglowe, sily w kN (uwaga - sprezystosc kB to 2*sprezystosc pojedynczego zderzaka!)
Cntrl. BrakeHandle=MHZ_K5P LocBrakeHandle=FD1 BrakeSystem=ElectroPneumatic MaxBPMass=52 BCPN=6 BDelay1=15 BDelay2=4 LocalBrake=PneumaticBrake MCPN=4 EIMCtrlType=2 SCPN=1 MainInitTime=10 IniCDelay=1.0 SCDelay=0.2 CoupledCtrl=No SBD=0.6 ASB=Yes CompressorStart=Automatic ConverterStart=Automatic ConverterStartDelay=0.0 PantCompressorStart=Mixed PantAutoValve=Yes BrakeDelays=PR BrakeOpModes=PN DirChangeMaxPos=3 HAO=No HMO=Yes HGDP1=0 ReleaseParkingBySpringBrake=Yes MotorBlowersStart=Converter CompartmentLightsStart=Manual AutomaticCabActivation=No InactivaCabEmergencyBrake=Yes InactiveCabFlag=3
-1 0.5 	0.0	6  ElectroPneumatic
 0 0.5	-1	4  ElectroPneumatic
