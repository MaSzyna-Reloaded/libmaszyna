// dlugosc ze zderzakami, wysokosc, szerokosc [m], wspolcz. oporu aerodynam.
Wheels: D=0.850 AIM=8000 Tw=1.435 Axle=Bo' Ad=2.83 Bd=16.3 Rmin=80 BearingType=Roll
// srednica kol napednych, moment bezwladosci [kgm^2], szerokosc, uklad i rozstaw osi, rozstaw czopow, min. promien skretu [m]
Brake: BrakeValve=EStED NBpA=4 MBF=85.0 MaxBP=3.1 MaxLBP=4.2 RM=0.74 RV=-1 BCN=4 BCR=0.127 BCD=0.05 BCM=1.9075 HiPP=5 LoPP=3.5 Vv=0.5 MinCP=7.0 MaxCP=8.5 CompressorSpeed=0.0 BVV=150 BM=Cosid BCS=1 BSA=0.00 BRE=0.95 TareMaxBP=2.6 CompressorPower=Converter LPOn=3.0 LPOff=4.5 UBB1=2 UBB2=8
SpringBrake: Volume=10 MBF=2.9 MaxSP=5.5 ResetP=4.0 MinFP=3.5 PressOff=4.5 PressOn=4.2 ValveOnArea=0.0005 ValveOffArea=0.0005 ValvePNBArea=0.002 MTC=4
Doors: OpenCtrl=Mixed CloseCtrl=DriverCtrl OpenSpeed=0.24 CloseSpeed=0.2 DoorMaxShiftL=0.74 DoorMaxShiftR=0.74 DoorOpenMethod=Plug DoorStayOpen=5.0 DoorClosureWarningAuto=Yes DoorBlocked=Yes DoorMaxShiftPlug=0.05 DoorCloseDelay=1.8 PlatformMaxShift=0.270 PlatformSpeed=0.4 PlatformOpenMethod=Shift MirrorMaxShift=45 DoorNeedPermit=Yes DoorPermitList=1|0|2|3 DoorPermitListDefault=2 DoorAutoCloseRemote=No MirrorVelClose=25
BuffCoupl1. CType=Articulated kB=4200 DmaxB=0.05 FmaxB=1740 kC=6800 DmaxC=0.15 FmaxC=780 beta=0.58 AllowedFlag=-255
BuffCoupl2. CType=Automatic kB=4200 DmaxB=0.05 FmaxB=1740 kC=6800 DmaxC=0.15 FmaxC=780 beta=0.58 AllowedFlag=39 AutomaticFlag=39 ControlType=en76_ks
