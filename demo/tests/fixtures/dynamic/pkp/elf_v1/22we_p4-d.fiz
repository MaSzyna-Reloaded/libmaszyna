Cntrl. BrakeHandle=MHZ_K5P LocBrakeHandle=FD1 BrakeSystem=ElectroPneumatic MaxBPMass=35 BCPN=6 BDelay1=15 BDelay2=4 LocalBrake=PneumaticBrake MCPN=4 EIMCtrlType=2 SCPN=0 MainInitTime=10 IniCDelay=1.0 SCDelay=0.2 CoupledCtrl=No SBD=0.6 ASB=Yes CompressorStart=Automatic ConverterStart=Automatic ConverterStartDelay=0.0 PantCompressorStart=Mixed PantAutoValve=Yes BrakeDelays=PR BrakeOpModes=PN DirChangeMaxPos=3 HAO=No HMO=Yes HGDP1=0 ReleaseParkingBySpringBrake=Yes MotorBlowersStart=Converter CompartmentLightsStart=Manual AutomaticCabActivation=No InactivaCabEmergencyBrake=Yes InactiveCabFlag=3
