// to jest plik z parametrami dla EP01
// stale uniwersalne stosowane dla kazdego pojazdu
Param. Category=train M=75200 Vmax=100 PWR=1360 SandCap=700
// rodzaj (train,auto,ship), masa [kg], Vmax [km/h], moc [kW] 
Dimensions: L=13.564 H=4.572 W=2.896 Cx=0.3 
// dlugosc ze zderzakami, wysokosc, szerokosc [m], wspolcz. oporu aerodynam.
Wheels: D=1.220 AIM=2000 Tw=1.435 Axle=Bo'Bo' Ad=2.8 Bd=7.45  Rmin=100 BearingType=Slide
// srednica kol napednych, moment bezwladosci [kgm^2], szerokosc, uklad i rozstaw osi, rozstaw czopow, min. promien skretu [m]
Brake: BrakeValve=K NBpA=4 MBF=85.0 MaxBP=2.8 RM=0.43 LocMaxBP=3.5 BCN=8 BCR=0.1524 BCD=0.12 BCM=8.7 HiPP=5 LoPP=3.5 Vv=0.83 MinCP=7.0 MaxCP=8.0 CompressorSpeed=0.03 BCS=0.8 BSA=0 BM=P10-Bgu BVV=200 BRE=0.8
// ilosc elementow ciernych na os, max sila docisku ham. recznego [kN], max. cisnienie w cyl., 
// cylindry: ilosc, promien, skok roboczy, mnoznik przekladni,
// cisnienie nominalne w przew. glownym [MPa], opcjonalnie dane dotyczace sprezarki i zbiornika glownego
BuffCoupl. CType=Screw kB=9200 DmaxB=0.15 FmaxB=740 kC=4800 DmaxC=0.15 FmaxC=850 beta=0.5 AllowedFlag=3
// urzadzenia zderzno-cieglowe, sily w kN (uwaga - sprezystosc kB to 2*sprezystosc pojedynczego zderzaka!)
Cntrl. BrakeHandle=Knorr LocBrakeHandle=Knorr BrakeSystem=Pneumatic BCPN=4 BDelay1=15 BDelay2=4 BDelay3=35 BDelay4=25 ASB=Manual LocalBrake=PneumaticBrake ManualBrake=Yes DynamicBrake=Passive BrakeDelays=GPR MCPN=31 SCPN=3 AutoRelay=Yes SCIM=1 IniCDelay=0.4 SCDelay=0.4
