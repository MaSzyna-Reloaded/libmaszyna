#!/usr/bin/env bash
# A script or shader Godot gives a `.uid` is committed together with it: a staged `.gd`,
# `.gdshader` or `.gdshaderinc` whose `<file>.uid` is not in the index fails - also when Godot has
# not written it yet (the file never imported: `godot --headless --path <project> --import`). It
# checks the repository it is run in, so a game with libmaszyna as a submodule runs this one too.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

missing=()
while IFS= read -r -d '' file; do
    case "${file}" in
        *.gd|*.gdshader|*.gdshaderinc) ;;
        *) continue ;;
    esac
    uid="${file}.uid"
    if ! git ls-files --error-unmatch --cached -- "${uid}" >/dev/null 2>&1; then
        missing+=("${uid}")
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#missing[@]}" -gt 0 ]; then
    echo "check-staged-uids: stage the .uid of every staged script and shader (one not written" >&2
    echo "yet: godot --headless --path <project> --import):" >&2
    printf '  git add %s\n' "${missing[@]}" >&2
    exit 1
fi
