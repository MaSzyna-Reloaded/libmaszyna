.PHONY: install runserver

BASEURL := /MaSzyna-API-wrapper
# Without Ruby on the host the whole site - the class reference generated by
# scripts/make-api-docs and Jekyll itself - is built in the official Ruby image, which carries
# python3 as well. The gems live in a named volume, so they are installed once, and the site is
# built inside the container rather than into docs/, which would otherwise fill up with files owned
# by root.
DOCKER_RUBY_IMAGE := ruby:3.3
DOCKER_GEMS_VOLUME := maszyna-docs-gems
DOCKER_RUN := docker run --rm -it -v "$(abspath $(CURDIR)/..):/srv" -v $(DOCKER_GEMS_VOLUME):/usr/local/bundle \
	-w /srv/docs -p 4000:4000 -p 35729:35729 $(DOCKER_RUBY_IMAGE)

ifneq ($(shell command -v bundle),)

install:
	bundle install

runserver: install
	python3 ../scripts/make-api-docs api
	bundle exec jekyll serve --livereload --baseurl "$(BASEURL)"

else

install:
	$(DOCKER_RUN) bundle install

# the class reference is generated as the host user, so docs/api stays the host's to overwrite
runserver:
	docker run --rm --user "$(shell id -u):$(shell id -g)" -v "$(abspath $(CURDIR)/..):/srv" $(DOCKER_RUBY_IMAGE) \
		python3 /srv/scripts/make-api-docs /srv/docs/api
	$(DOCKER_RUN) sh -c 'bundle install && bundle exec jekyll serve --host 0.0.0.0 --livereload \
		--baseurl "$(BASEURL)" --destination /tmp/site'

endif
