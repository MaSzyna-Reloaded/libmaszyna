[gd_scene format=3]

[ext_resource type="Script" path="res://addons/libmaszyna/debug_hud/scenario_events_panel.gd" id="1_events"]

[node name="ScenarioEventsPanel" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_events")

[node name="Time" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="QueueCaption" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="Queue" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="LogCaption" type="Label" parent="."]
layout_mode = 2
text = "Last events"

[node name="Log" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="RefreshTimer" type="Timer" parent="."]
wait_time = 0.25
autostart = true

[connection signal="timeout" from="RefreshTimer" to="." method="_refresh"]
